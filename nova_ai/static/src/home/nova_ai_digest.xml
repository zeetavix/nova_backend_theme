<templates xml:space="preserve">
    <t t-name="nova_ai.NovaHomeDigest"
       t-inherit="nova_backend_theme.NovaHome"
       t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('nova_section')][.//button[hasclass('nova_kpi')]]" position="inside">
            <p t-if="this.novaDigestText" class="nova_ai_digest">
                <span class="nova_ai_digest_badge" aria-hidden="true">
                    <svg class="nova_ai_glyph" width="1em" height="1em" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2.5c.7 4.6 3 6.9 7.6 7.6-4.6.7-6.9 3-7.6 7.6-.7-4.6-3-6.9-7.6-7.6 4.6-.7 6.9-3 7.6-7.6Z" fill="currentColor"/><circle cx="19" cy="5.5" r="1.7" fill="currentColor"/><circle cx="5" cy="18.5" r="1.7" fill="currentColor"/></svg>
                    Ask Nova
                </span>
                <span class="nova_ai_digest_body">
                    <span class="nova_ai_digest_text"><t t-out="this.novaDigestText"/></span>
                    <span t-if="this.novaFigureChips.length" class="nova_ai_digest_chips">
                        <span t-foreach="this.novaFigureChips"
                              t-as="chip"
                              t-key="chip_index"
                              class="nova_ai_digest_chip"
                              t-out="chip"/>
                    </span>
                </span>
            </p>
        </xpath>
    </t>
</templates>
