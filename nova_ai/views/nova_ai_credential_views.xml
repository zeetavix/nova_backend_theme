<?xml version="1.0" encoding="utf-8"?>
<!-- Part of Nova. See LICENSE file for full copyright and licensing details.
     Vault admin screens. Standard list/form widgets only, so the Nova
     backend theme (light + dark) styles them with zero custom CSS.
     Values use password masking; only admins ever see these views. -->
<odoo>
    <record id="nova_ai_credential_view_tree" model="ir.ui.view">
        <field name="name">nova.ai.flow.credential.list</field>
        <field name="model">nova.ai.flow.credential</field>
        <field name="arch" type="xml">
            <list string="Flow credentials" decoration-muted="active == False">
                <field name="name"/>
                <field name="kind"/>
                <field name="active" optional="hide"/>
                <field name="last_used_at" optional="show"/>
            </list>
        </field>
    </record>

    <record id="nova_ai_credential_view_form" model="ir.ui.view">
        <field name="name">nova.ai.flow.credential.form</field>
        <field name="model">nova.ai.flow.credential</field>
        <field name="arch" type="xml">
            <form string="Flow credential">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Name"/>
                        <h1><field name="name" placeholder="stripe_webhook"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="kind"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="last_used_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Secret">
                        <field name="value" nolabel="1" password="True"
                               placeholder="Paste once — nodes reference this entry by name, never by value."/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Nodes carry <code>credentials: {name: id}</code> and the
                        engine resolves the value at run time. The value is
                        masked in every view and every read is audit-logged.
                    </div>
                </sheet>
                <!-- No chatter: secrets never sprout threads, and the
                     model stays thread-free on purpose. -->
            </form>
        </field>
    </record>

    <record id="nova_ai_credential_view_search" model="ir.ui.view">
        <field name="name">nova.ai.flow.credential.search</field>
        <field name="model">nova.ai.flow.credential</field>
        <field name="arch" type="xml">
            <search string="Credentials">
                <field name="name"/>
                <field name="kind"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <group>
                    <filter name="group_kind" string="Kind" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nova_ai_credential" model="ir.actions.act_window">
        <field name="name">Flow credentials</field>
        <field name="res_model">nova.ai.flow.credential</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="nova_ai_credential_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No credentials yet</p>
            <p>Store webhook HMAC secrets, HTTP auth and API tokens here.
               Flows reference them by name — secrets never live in JSON.</p>
        </field>
    </record>
</odoo>
