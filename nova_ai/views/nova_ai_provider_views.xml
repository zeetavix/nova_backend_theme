<odoo>
    <record id="action_nova_ai_provider" model="ir.actions.act_window">
        <field name="name">Providers</field>
        <field name="res_model">nova.ai.provider</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No providers yet</p>
            <p>Point Nova at any model endpoint — a local Ollama on your machine, or a hosted OpenAI-compatible API. Keys stay in this database and are never sent to the browser.</p>
        </field>
    </record>

    <record id="view_nova_ai_provider_list" model="ir.ui.view">
        <field name="name">nova.ai.provider.list</field>
        <field name="model">nova.ai.provider</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="kind" />
                <field name="base_url" />
                <field name="default_model" />
                <field name="model_count" string="Models" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="view_nova_ai_provider_search" model="ir.ui.view">
        <field name="name">nova.ai.provider.search</field>
        <field name="model">nova.ai.provider</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Provider" />
                <field name="base_url" />
                <filter name="kind_ollama" string="Ollama"
                        domain="[('kind', '=', 'ollama')]" />
                <filter name="kind_openai" string="OpenAI-compatible"
                        domain="[('kind', '=', 'openai_compat')]" />
            </search>
        </field>
    </record>

    <record id="view_nova_ai_provider_form" model="ir.ui.view">
        <field name="name">nova.ai.provider.form</field>
        <field name="model">nova.ai.provider</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" placeholder="e.g. Local Ollama" /></h1>
                    </div>
                    <group>
                        <group name="connection">
                            <field name="kind" />
                            <field name="base_url" placeholder="http://localhost:11434" />
                            <field name="api_key" password="True" placeholder="sk-… (if needed)" />
                            <field name="default_model" />
                            <field name="timeout" placeholder="0 = dialect default" />
                            <field name="active" />
                        </group>
                        <group name="state">
                            <field name="model_count" />
                        </group>
                    </group>
                    <notebook>
                        <page name="models" string="Models">
                            <field name="model_ids">
                                <list>
                                    <field name="name" />
                                    <field name="tier" />
                                    <field name="context_length" />
                                    <field name="supports_tools" />
                                    <field name="supports_embeddings" />
                                </list>
                            </field>
                        </page>
                        <page name="note" string="Notes">
                            <field name="note" placeholder="Who owns this endpoint, where it runs, what it costs." />
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_test_connection" type="object"
                            string="Test connection" class="btn-secondary" />
                    <button name="action_sync_models" type="object"
                            string="Sync models" class="btn-primary" />
                    <button name="action_prepare_voice" type="object"
                            string="Prepare offline voice" class="btn-secondary"
                            title="Download the speech voice, load whisper, and prove both work. Slow once, instant after." />
                </footer>
            </form>
        </field>
    </record>
</odoo>
