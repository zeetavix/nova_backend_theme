<odoo>
    <record id="action_nova_ai_session" model="ir.actions.act_window">
        <field name="name">Sessions</field>
        <field name="res_model">nova.ai.session</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No conversations yet</p>
            <p>Every chat with an agent lands here — useful for auditing what an agent was told and what it answered.</p>
        </field>
    </record>

    <record id="view_nova_ai_session_list" model="ir.ui.view">
        <field name="name">nova.ai.session.list</field>
        <field name="model">nova.ai.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="last_write" />
                <field name="agent_id" />
                <field name="user_id" />
                <field name="title" />
                <field name="context_model" />
                <field name="context_res_id" />
            </list>
        </field>
    </record>

    <record id="view_nova_ai_session_form" model="ir.ui.view">
        <field name="name">nova.ai.session.form</field>
        <field name="model">nova.ai.session</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                    <group>
                        <group>
                            <field name="agent_id" />
                            <field name="user_id" />
                            <field name="last_write" />
                        </group>
                        <group>
                            <field name="context_model" />
                            <field name="context_res_id" />
                        </group>
                    </group>
                    <notebook>
                        <page name="messages" string="Messages">
                            <field name="message_ids" readonly="1">
                                <list>
                                    <field name="created_at" />
                                    <field name="role" />
                                    <field name="content" />
                                    <field name="steps" />
                                </list>
                            </field>
                        </page>
                        <page name="pending" string="Pending confirmations">
                            <field name="pending" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
