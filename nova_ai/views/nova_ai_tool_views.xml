<odoo>
    <record id="action_nova_ai_tool" model="ir.actions.act_window">
        <field name="name">Tools</field>
        <field name="res_model">nova.ai.tool</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_nova_ai_tool_list" model="ir.ui.view">
        <field name="name">nova.ai.tool.list</field>
        <field name="model">nova.ai.tool</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="tier_min" width="120px" widget="nova_tier_badge" />
                <field name="write_kind" width="140px" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="view_nova_ai_tool_search" model="ir.ui.view">
        <field name="name">nova.ai.tool.search</field>
        <field name="model">nova.ai.tool</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Tool" />
                <filter name="reads" string="Reads data"
                        domain="[('write_kind', '=', 'none')]" />
                <filter name="writes" string="Writes with confirm"
                        domain="[('write_kind', '=', 'confirm')]" />
                <group>
                    <filter name="group_tier" string="Tier"
                            context="{'group_by': 'tier_min'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_nova_ai_tool_form" model="ir.ui.view">
        <field name="name">nova.ai.tool.form</field>
        <field name="model">nova.ai.tool</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" placeholder="Search records" /></h1>
                        <h3><field name="code" /></h3>
                    </div>
                    <group>
                        <group name="gating">
                            <field name="tier_min" />
                            <field name="write_kind" />
                            <field name="allowed_models" placeholder="Empty = every model" />
                            <field name="rate_limit_per_hour" />
                            <field name="active" />
                        </group>
                    </group>
                    <field name="description" placeholder="Written for the model: what this tool does and when to use it." />
                    <group name="schema">
                        <field name="schema" colspan="2" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nova_ai_log" model="ir.actions.act_window">
        <field name="name">Audit log</field>
        <field name="res_model">nova.ai.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing logged yet</p>
            <p>Every provider call, probe and tool call lands here with its latency and token counts.</p>
        </field>
    </record>

    <record id="view_nova_ai_log_list" model="ir.ui.view">
        <field name="name">nova.ai.log.list</field>
        <field name="model">nova.ai.log</field>
        <field name="arch" type="xml">
            <list string="Audit log" create="0" edit="0">
                <field name="created_at" />
                <field name="user_id" />
                <field name="agent_id" />
                <field name="kind" />
                <field name="ok" />
                <field name="latency_ms" string="Latency (ms)" />
                <field name="tokens_in" />
                <field name="tokens_out" />
                <field name="rounds" />
            </list>
        </field>
    </record>

    <record id="view_nova_ai_log_search" model="ir.ui.view">
        <field name="name">nova.ai.log.search</field>
        <field name="model">nova.ai.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="agent_id" />
                <field name="user_id" />
                <filter name="kind_chat" string="Chat"
                        domain="[('kind', '=', 'chat')]" />
                <filter name="kind_tool" string="Tool calls"
                        domain="[('kind', '=', 'tool')]" />
                <filter name="kind_probe" string="Probes"
                        domain="[('kind', '=', 'probe')]" />
                <separator />
                <filter name="errors" string="Errors"
                        domain="[('ok', '=', False)]" />
                <separator />
                <filter name="today" string="Today"
                        domain="[('created_at', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]" />
            </search>
        </field>
    </record>

    <record id="view_nova_ai_log_form" model="ir.ui.view">
        <field name="name">nova.ai.log.form</field>
        <field name="model">nova.ai.log</field>
        <field name="arch" type="xml">
                    <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="created_at" />
                            <field name="user_id" />
                            <field name="agent_id" />
                            <field name="kind" />
                            <field name="ok" />
                        </group>
                        <group>
                            <field name="latency_ms" string="Latency (ms)" />
                            <field name="tokens_in" />
                            <field name="tokens_out" />
                            <field name="rounds" />
                        </group>
                    </group>
                    <field name="error" />
                    <group>
                        <field name="detail" colspan="2" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
