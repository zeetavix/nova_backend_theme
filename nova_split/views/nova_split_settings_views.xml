<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.nova.split</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Nova Split View" name="nova_split">
                    <block title="Split View Defaults" name="nova_split_setting_container">
                        <setting string="Offer Split automatically" help="Add Split to the view switcher of every action that shows both a list and a form.">
                            <field name="nova_split_auto_inject"/>
                        </setting>
                        <setting string="Open the first record automatically" help="When Split opens, immediately show the first row in the side panel instead of an empty state.">
                            <field name="nova_split_auto_open"/>
                        </setting>
                        <setting string="Side panel width" help="Initial width of the form panel in pixels (320 to 1600). Users can resize or expand it; their width choice is remembered.">
                            <field name="nova_split_default_width"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
